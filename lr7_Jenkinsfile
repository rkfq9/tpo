node {
    stage('Check QEMU OpenBMC') {
        echo 'Проверка, что OpenBMC запущен в WSL...'
        sh 'sshpass -p "19" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null kirill@192.168.163.153 "curl -k -s -o /dev/null -w \'%{http_code}\' https://127.0.0.1:2443/redfish/v1/ | grep 200"'
        echo 'OpenBMC доступен!'
    }
    
    stage('API Tests (PyTest)') {
        echo 'Запуск PyTest...'
        sh 'sshpass -p "19" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null kirill@192.168.163.153 "cd ~/openbmc_pytest && python3 -m pytest test_redfish.py -v" > pytest_report.log 2>&1 || true'
    }
    
    stage('WebUI Tests') {
        echo 'Запуск WebUI...'
        sh 'sshpass -p "19" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null kirill@192.168.163.153 "cd ~/openbmc_tests && python3 openbmc_redfish_tests.py" > webui_report.log 2>&1 || true'
    }
    
    stage('Load Testing (Locust)') {
        echo 'Запуск Locust...'
        sh 'sshpass -p "19" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null kirill@192.168.163.153 "cd ~/openbmc_locust && python3 -m locust -f locustfile.py --headless -u 10 -r 2 --run-time 20s" > locust_report.log 2>&1 || true'
    }
    
    stage('Archive Results') {
        echo 'Сохранение логов...'
        archiveArtifacts artifacts: '*.log', allowEmptyArchive: true
    }
}
