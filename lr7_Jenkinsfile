node {
    stage('Start QEMU OpenBMC') {
        echo 'Запуск QEMU через SSH в WSL...'
        sh 'sshpass -p "19" ssh -o StrictHostKeyChecking=no kirill@192.168.163.153 "pkill -f qemu-system-arm || true"'
        sh 'sshpass -p "19" ssh -o StrictHostKeyChecking=no kirill@192.168.163.153 "cd /mnt/c/Users/kirill/archive/archive/openbmc/build/tmp/deploy/images/romulus && nohup qemu-system-arm -m 256 -M romulus-bmc -nographic -drive file=obmc-phosphor-image-romulus-20260908025120.static.mtd,format=raw,if=mtd -net nic -net user,hostfwd=:0.0.0.0:2222-:22,hostfwd=:0.0.0.0:2443-:443,hostfwd=udp:0.0.0.0:2623-:623,hostname=qemu > qemu_boot.log 2>&1 &"'
        sh 'sleep 30'
        sh 'sshpass -p "19" ssh -o StrictHostKeyChecking=no kirill@192.168.163.153 "cat /mnt/c/Users/kirill/archive/archive/openbmc/build/tmp/deploy/images/romulus/qemu_boot.log" > qemu_boot.log'
    }
    
    stage('API Tests (PyTest)') {
        echo 'Реальный запуск PyTest в WSL...'
        sh 'sshpass -p "19" ssh -o StrictHostKeyChecking=no kirill@192.168.163.153 "cd ~/openbmc_pytest && python3 -m pytest test_redfish.py -v" > pytest_report.log 2>&1'
    }
    
    stage('WebUI Tests') {
        echo 'Реальный запуск WebUI тестов в WSL...'
        sh 'sshpass -p "19" ssh -o StrictHostKeyChecking=no kirill@192.168.163.153 "cd ~/openbmc_tests && python3 openbmc_redfish_tests.py" > webui_report.log 2>&1'
    }
    
    stage('Load Testing (Locust)') {
        echo 'Реальный запуск Locust в WSL...'
        sh 'sshpass -p "19" ssh -o StrictHostKeyChecking=no kirill@192.168.163.153 "cd ~/openbmc_locust && python3 -m locust -f locustfile.py --headless -u 10 -r 2 --run-time 20s" > locust_report.log 2>&1'
    }
    
    stage('Archive Results') {
        echo 'Сохранение логов в артефакты Jenkins...'
        archiveArtifacts artifacts: '*.log', allowEmptyArchive: true
    }
}
